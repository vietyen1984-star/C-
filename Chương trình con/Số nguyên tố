//Cho số nguyên dương N. Gọi K là tổng các chữ số của N. Hãy kiểm tra xem K có phải là số nguyên tố không?
#include <iostream>
using namespace std;
int sum=0;
bool check(int n){
    if(n<2) return false;
    while(n>0){
        sum=sum+n%10;
        n=n/10;
    }
    for(int i=2;i<sum;i++){
        if(sum%i==0)
        return false;
    }
    return true;
}
int main() 
{
    int n;
    cin>>n;
    if(check(n)==true)
    cout<<"YES";
    else cout<<"NO";
    return 0;
}

//Cho số tự nhiên N. Hãy tính tổng các số nguyên tố nhỏ hơn hoặc bằng N.
#include <iostream>
using namespace std;
bool check(int n){
    if(n<2) return false;
    for(int i=2;i<n;i++){
    if(n%i==0)
    return false;
    }
    return true;
}
int main() 
{
    int n,sum=0;
    cin>>n;
    for(int i=0;i<=n;i++)
    if(check(i)==true)
    sum=sum+i;
    cout<<sum;
    return 0;
}

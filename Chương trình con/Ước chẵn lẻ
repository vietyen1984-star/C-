//Định nghĩa hàm f(x) là số lượng các ước dương của x.
#include <bits/stdc++.h>
using namespace std;
int check(int n){
    int sum=0;
    for(int i=1;i<=n;i++){
    if(n%i==0)
    sum++;
    }
    return sum;
}
int main() 
{
    int n;
    cin>>n;
    vector <int> a;
    a.resize(n);
    for(int i=0;i<n;i++){
        cin>>a[i];
        if(check(a[i])%2==0) cout<<"CHAN"<<endl;
        else  cout<<"LE"<<endl;
    }    
    return 0;
}

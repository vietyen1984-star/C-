//Cho dãy N (1 <= N <= 105) số nguyên dương A1, A2, ..., AN (Ai <= 109). 
//Với bộ ba số (i, j, k) trong đó 1 <= i < j < k <= N hãy tìm giá trị S = 2Ai – 3Aj + 5Ak sao cho S đạt giá trị lớn nhất.
#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int n,ans=0;
    cin>>n;
    vector<int> vec;
    vec.resize(n+1);
    for(int i=1;i<=n;i++)
    cin>>vec[i];
    for(int i=1;i<=n;i++){
        for(int j=i+1;j<=n;j++){
            for(int k=j+1;k<=n;k++)
            ans=max(ans,2*vec[i]-3*vec[j]+5*vec[k]);
        }
    }
    cout<<ans;
    return 0;
}

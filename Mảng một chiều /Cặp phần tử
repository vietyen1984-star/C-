//Cho dãy gồm N số nguyên dương A1, A2, …, AN và số nguyên dương S.
Hãy đếm xem có bao nhiêu cặp (i, j) thỏa mãn Ai + Aj = S (i < j)
#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int n,s,sum=0;
    cin>>n>>s;
    vector <int> a;
    a.resize(n);
    for(int i=0;i<n;i++)
    cin>>a[i];
    for(int i=0;i<n;i++){
      for(int j=0;j<i;j++)
        if(a[i]+a[j]==s)
        sum=sum+1;
    }
    cout << sum;
    return 0;
}

//Nam dự định tự tay đóng một chiếc giá sách cho mình. Nam đã tìm đến xưởng gỗ cạnh nhà để nhờ sự giúp đỡ về nguyên vật liệu đóng chiếc giá sách. Ông chủ xưởng dẫn Nam đi tới một khu và ở đó Nam có thể lọc lấynhững tấm gỗ mình cần. Vì có rất nhiều độ dài các gỗ khác nhau nên Nam sẽ phải lọc ra trong số này có bao nhiêu tấm gỗ có độ dài khác nhau và độ dài của các tấm gỗ đó là bao nhiêu. 
//Bạn hãy giúp Nam thực hiện việc phân loại này nhé.
#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int n,dem=0;
    cin>>n;
    vector<int> vec;
    vec.resize(1000);
    for(int i=0;i<n;i++) {
        int x;
        cin>>x;
        vec[x]++;
    }
    for(int i=0;i<1000;i++){
        if(vec[i]>0)
        dem++;
    }
    cout<<dem<<endl;
    for(int i=0;i<1000;i++) {
        if(vec[i]>0) 
        cout<<i<<" ";
    }
    return 0;
}

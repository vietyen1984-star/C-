//Cho dãy số gồm N phần tử A1, A2, ..., AN. Hãy đếm và tính tổng các số nguyên tố trong dãy.
#include <bits/stdc++.h>
using namespace std;
bool check_so_nguyen_to( int x ){
    if(x<2)
    return false;
    for(int i=2;i<x;i++)
    if(x%i==0){
    return false;
    }
    return true;
}
int main()
{
    int n;
    int sum=0,dem=0;
    cin>>n;
    int a[100];
    for(int i=0;i<n;i++) cin>>a[i];
    for(int i=0;i<n;i++)
    if(check_so_nguyen_to(a[i])==true){
        sum=sum+a[i];
        dem++;
    }
    cout<<sum<<" "<<dem;
}

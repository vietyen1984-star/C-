#include <bits/stdc++.h>
using namespace std;
bool check_so_dep(int x) {
    while(x!=0) {
        int digit = x%10;
        if(digit!=8&&digit!=6) return false;
        x=x/10;
    }
    return true;
}
int main()
{
    int n;
    int a[100];
    int dem=0;
    cin>>n;
    for(int i=0;i<n;i++) cin>>a[i];
    for(int i=0;i<n;i++) {
        if(check_so_dep(a[i])==true) dem++;
    }
    cout<<dem;
    return 0;
}

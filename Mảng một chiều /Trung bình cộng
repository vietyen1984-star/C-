//Nhập vào một dãy gồm n số thực. Tính trung bình cộng các phần tử trong dãy

#include <iostream>
#include <vector>
using namespace std;

int main() 
{
    vector <int> a;
    int n,sum=0;
    cin>>n;
    a.resize(n);
    for(int i=0;i<n;i++){
        cin>>a[i];
        sum=sum+a[i];
    }
    int tbc;
    tbc=sum/n;
    cout<<tbc;
    return 0;
}

#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int s,n;
    cin>>s>>n;
    int tmp=0;
    int sum=s;
    vector<int> x,y;
    x.resize(n+1);
    y.resize(n+1);
    for(int i=1;i<=n;i++){
        cin>>x[i]>>y[i];
    }
    for(int i=1;i<=n;i++){
        if(sum>x[i]) {
           sum=sum+y[i]; 
        }
        else tmp++;
    }
    if(tmp==0)
    cout<<"YES";
    else
    cout<<"NO"<<endl<<tmp;
    return 0;
}

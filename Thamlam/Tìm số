//Tìm số nguyên dương K nhỏ nhất sao cho tích các chữ số của K bằng số nguyên M cho trước.
// không tìm được K, in ra -1.
#include <iostream>
using namespace std;

int main() 
{
    int n;
    string s= "";
    cin>>n;
    if(n==0){ cout<<10;
    return 0;
    }
    for(int i=9;i>=2;i--){
        while(n%i==0){
            s = char(i+48) + s;
            n= n/i;
        }
    }
    if(n!=1) cout<<-1;
    cout << s;
}

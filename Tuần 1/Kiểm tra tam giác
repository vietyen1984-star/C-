//1.Kiểm tra xem 3 cạnh có tạo thành tam giác không
//2.Nếu có, in ra loại tam giác:Can ba — 3 cạnh bằng nhau,Can hai — 2 cạnh bằng nhau,Thuong — 3 cạnh khác nhau
#include <iostream>
using namespace std;

int main() 
{
    int a,b,c;
   cin>>a>>b>>c;
   if(a+b<c||b+c<a||a+c<b)
   cout<<"khong phai tam giac";
   else if(a==b&&b==c)
   cout<<"can ba";
   else if(a==b&&b!=c||a==c&&c!=b||b==c&&c!=a)
   cout<<"can hai";
   else
   cout<<"thuong";
    
    return 0;
}

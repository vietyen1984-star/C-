#include <iostream>
using namespace std;

int main() 
{
  int n,sum=1;
  cin>>n;
  while(n<42){
    cin>>n;
    sum=sum+1;
  }
  while(n>42){
    cin>>n;
    sum=sum+1;
  }
  cout<<"dung roi"<<" "<<sum;
    return 0;
}

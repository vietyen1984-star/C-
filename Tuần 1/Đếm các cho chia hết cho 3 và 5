//Nhập n, đếm có bao nhiêu số chia hết cho cả 3 và 5 trong khoảng từ 1 đến n.
//C1
#include <iostream>
using namespace std;

int main() 
{
   int n,sum=0;
   cin>>n;
   for(int i=1;i<=n;i++)
   if(i%3==0&&i%5==0) //if(i%15==0)
   sum=sum+1;
   cout<<sum;
    return 0;
}
